# sway config file
#
# Please see `man 5 sway` (https://man.archlinux.org/man/sway.5.en) for
# a complete reference!


#################
#    GENERAL    #
#################
# mod keys
set $mod Mod4
set $alt Mod1

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font Terminus 12

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
#font pango:DejaVu Sans Mono 8

# gaps
smart_gaps on
gaps outer 0
gaps inner 2

# borders
smart_borders no_gaps
hide_edge_borders --i3 smart_no_gaps
default_border pixel 1
default_floating_border pixel 1
titlebar_border_thickness 0
titlebar_padding 4 2

# focus/mouse
focus_wrapping force
focus_follows_mouse no
mouse_warping output

# hide cursor
seat * hide_cursor when-typing enable

# use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# correct handling of floating dialogs
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable

# xwayland title decoration
for_window [shell="xwayland"] title_format "[XWayland] %title"


################
#    COLORS    #
################
# empoleon main: 5f87d7
# empoleon light: 9eb6e6
# empoleon dark: 20407e
# class                 border  backgr. text    indicator
client.focused          #5f87d7 #5f87d7 #000000 #000000
client.focused_inactive #20407e #20407e #dedede #000000
client.unfocused        #444444 #444444 #dedede #000000

client.urgent           #af0000 #af0000 #dedede #000000
client.placeholder      #000000 #000000 #dedede #000000

client.background       #000000


########################
#    SWAY KEY BINDS    #
########################
# change focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# kill focused window
bindsym $mod+Shift+d kill

# alternatively, you can use the cursor keys:
# bindsym $mod+Left focus left
# bindsym $mod+Down focus down
# bindsym $mod+Up focus up
# bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+h move left 28 px
bindsym $mod+Shift+j move down 28 px
bindsym $mod+Shift+k move up 28 px
bindsym $mod+Shift+l move right 28 px

# alternatively, you can use the cursor keys:
bindsym $mod+Left move left 5 px
bindsym $mod+Down move down 5 px
bindsym $mod+Up move up 5 px
bindsym $mod+Right move right 5 px

bindsym $mod+Shift+Left move left 1 px
bindsym $mod+Shift+Down move down 1 px
bindsym $mod+Shift+Up move up 1 px
bindsym $mod+Shift+Right move right 1 px

# split in horizontal orientation
bindsym $mod+v split h

# split in vertical orientation
bindsym $mod+s split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+a layout stacking
bindsym $mod+q layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle; resize set 942 480; move position center
bindsym $mod+Control+space sticky toggle

# scratchpad stuff
bindsym $mod+Shift+minus sticky enable; move scratchpad
bindsym $mod+minus scratchpad show

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+x focus parent

# focus the child container
bindsym $mod+c focus child

# toggle border
bindsym $mod+z border toggle

# switch to workspace
workspace_auto_back_and_forth no
bindsym $mod+Control+h workspace prev_on_output
bindsym $mod+Control+l workspace next_on_output
bindsym $mod+Control+q workspace back_and_forth
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10
bindsym $mod+$alt+1 workspace 11
bindsym $mod+$alt+2 workspace 12
bindsym $mod+$alt+3 workspace 13
bindsym $mod+$alt+4 workspace 14
bindsym $mod+$alt+5 workspace 15
bindsym $mod+$alt+6 workspace 16
bindsym $mod+$alt+7 workspace 17
bindsym $mod+$alt+8 workspace 18
bindsym $mod+$alt+9 workspace 19
bindsym $mod+$alt+0 workspace 20

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10
bindsym $mod+Shift+$alt+1 move container to workspace 11
bindsym $mod+Shift+$alt+2 move container to workspace 12
bindsym $mod+Shift+$alt+3 move container to workspace 13
bindsym $mod+Shift+$alt+4 move container to workspace 14
bindsym $mod+Shift+$alt+5 move container to workspace 15
bindsym $mod+Shift+$alt+6 move container to workspace 16
bindsym $mod+Shift+$alt+7 move container to workspace 17
bindsym $mod+Shift+$alt+8 move container to workspace 18
bindsym $mod+Shift+$alt+9 move container to workspace 19
bindsym $mod+Shift+$alt+0 move container to workspace 20

# move workspace to left and right monitors
bindsym $mod+Shift+bracketleft move workspace to output left
bindsym $mod+Shift+bracketright move workspace to output right

# reload the configuration file
bindsym $mod+Shift+c reload
# exit sway (logs you out of your wayland session)
bindsym $mod+Shift+e exec "swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your wayland session.' -b 'Yes, exit wayland' 'swaymsg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym h resize shrink width 42 px or 12 ppt
        bindsym j resize grow height 42 px or 12 ppt
        bindsym k resize shrink height 42 px or 12 ppt
        bindsym l resize grow width 42 px or 12 ppt

        bindsym Shift+h resize shrink width 11 px or 2 ppt
        bindsym Shift+j resize grow height 11 px or 2 ppt
        bindsym Shift+k resize shrink height 11 px or 2 ppt
        bindsym Shift+l resize grow width 11 px or 2 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 1 px or 1 ppt
        bindsym Down resize grow height 1 px or 1 ppt
        bindsym Up resize shrink height 1 px or 1 ppt
        bindsym Right resize grow width 1 px or 1 ppt

        # back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"


########################
#    MISC KEY BINDS    #
########################
# start menu/program launcher
bindsym $mod+d exec --no-startup-id BEMENU_SCALE=1 \
        bemenu-run -i -p '>' --fn 'Terminus 24' -H 36 --hp 12 --tf '#5f87d7' --hf '#5f87d7'

# program binds
bindsym $mod+t exec foot
bindsym $mod+m exec foot cmus
bindsym $mod+w exec qutebrowser

# volume controls
# use pactl to adjust volume in PulseAudio.
set $refresh_i3blocks pkill -RTMIN+10 i3blocks
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_SINK@ 2%+ && $refresh_i3blocks
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_SINK@ 2%- && $refresh_i3blocks
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_SINK@ toggle && $refresh_i3blocks
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_SOURCE@ toggle

# brightness controls
bindsym XF86MonBrightnessUp exec brightnessctl --exponent=3 set 3%+
bindsym XF86MonBrightnessDown exec brightnessctl --exponent=3 set 3%-


#############
#    BAR    #
#############
# Start swaybar to display a workspace bar (plus the system information
# i3blocks finds out, if available)
bar {
        status_command i3blocks
        tray_output none
        position top
        height 18
        gaps 0
        separator_symbol "|"
        colors {
            background #000000
            statusline #dedede
            separator #777777

            # <colorclass> <border> <background> <text>
            focused_workspace  #5f87d7 #5f87d7 #000000
            active_workspace   #20407e #20407e #dedede
            inactive_workspace #444444 #444444 #dedede
            urgent_workspace   #af0000 #af0000 #dedede
            binding_mode       #af0000 #af0000 #dedede
        }
}


###############
#    INPUT    #
###############
# mouse (general)
input type:pointer {
    accel_profile flat
    pointer_accel 0
}

# touchpad
#
# Custom acceleration function generated with
# `windows-acceleration-function.py`, linked at the bottom of the libinput
# merge request:
# https://gitlab.freedesktop.org/libinput/libinput/-/merge_requests/775
#
# "libinput Accel Custom Motion Points" 0.000, 0.079, 0.159, 0.274, 0.393, 0.512, 0.632, 0.804, 0.985, 1.167, 1.348, 1.529, 1.711, 1.892, 2.074, 2.255, 2.436, 2.618, 2.799, 2.981, 3.355
# "libinput Accel Custom Motion Step" 0.2031610269
input 'type:touchpad' {
    dwt enabled
    dwtp enabled
    accel_profile adaptive
    pointer_accel 0
    scroll_factor 0.5
    scroll_method two_finger
    natural_scroll disabled
    tap disabled
    click_method clickfinger
    clickfinger_button_map lrm
    middle_emulation enabled
}

# trackpoint
input '2:10:TPPS/2_Elan_TrackPoint' {
    accel_profile flat
    pointer_accel 0.5
    scroll_factor 0.5
}

# keyboard (thinkpad)
input '1:1:AT_Translated_Set_2_keyboard' {
    xkb_options 'caps:capslock,altwin:prtsc_rwin'
}


################
#    OUTPUT    #
################
# monitor workspaces
workspace 11 output HDMI-1
workspace 16 output DP-1

# all
output * {
    bg ~/.desktop_backgrounds/tyranitar.png fill
    max_render_time 2
    allow_tearing yes
    adaptive_sync on
}


########################
#    LAUNCH DAEMONS    #
########################
exec wl-gammarelay
exec easyeffects --hide-window --service-mode
exec swayidle -w \
  before-sleep 'sh $HOME/.config/swayidle/before-sleep.sh' \
  after-resume 'sh $HOME/.config/swayidle/after-resume.sh'
